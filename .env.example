# ---- LLM (multi-provider: google | openai | anthropic) ----
# google = Gemini (recomendado: barato, rápido, misma key que nano banana)
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash          # tareas baratas: selección, prompts, timing
LLM_MODEL_DRAFT=gemini-2.5-pro      # redacción de posts y comentarios
# Solo si usas esos providers:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- X (Twitter) API v2 ----
# https://developer.x.com -> plan Basic (de pago) para poder postear
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Bearer Token: para LEER cuentas/tendencias y métricas (plan Free o Basic)
X_BEARER_TOKEN=
# Cuentas de X a vigilar (sin @, separadas por comas). Vacío = lista por defecto
X_ACCOUNTS=OpenAI,GoogleDeepMind,AnthropicAI,huggingface,svpino,DrJimFan

# ---- Telegram (aprobación humana) ----
# Crea un bot con @BotFather y obtén tu chat_id escribiéndole a @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Imágenes (nano banana / Gemini image) ----
# API key gratis en https://aistudio.google.com/apikey
ENABLE_IMAGES=false
GOOGLE_API_KEY=
IMAGE_MODEL=gemini-2.5-flash-image

# ---- Agente ----
POSTS_PER_DAY=2
TIMEZONE=Europe/Madrid
DRY_RUN=true   # true = no publica, solo envía borradores a Telegram
DATA_DIR=/tmp/zanax-data   # historial de publicaciones y horarios aprendidos

# ---- Crecimiento (topes anti-suspensión) ----
FOLLOW_PER_DAY=10          # máx. cuentas nuevas al día
UNFOLLOW_PER_WEEK=5        # máx. unfollows por semana
X_NEVER_UNFOLLOW=          # cuentas protegidas (sin @, separadas por comas)
