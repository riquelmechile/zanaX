# ---- MODO GRATIS (recomendado, default) ----
# true = cero lecturas de la API de X: research por fuentes free, horas fijas,
# imágenes por cuota gratis de AI Studio. Coste total ≈ $0/mes.
# Pon false solo si pagas API de X con lecturas.
FREE_MODE=true

# ---- LLM: Gemini capa GRATIS de AI Studio ----
# Key gratis en https://aistudio.google.com/apikey (sirve para LLM + imágenes)
GOOGLE_API_KEY=
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash          # análisis: ~1.500 req/día gratis
LLM_MODEL_DRAFT=gemini-2.5-flash    # redacción: mismo modelo gratis
# Providers de pago (opcional):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- X (Twitter) API v2 ----
# https://developer.x.com -> capa FREE alcanza para publicar (~500 posts/mes,
# límite 17/día). Solo necesitas las 4 claves OAuth de tu app.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Bearer Token: SOLO en modo de pago (FREE_MODE=false). En gratis no se usa.
X_BEARER_TOKEN=
# Cuentas a vigilar (solo modo de pago)
X_ACCOUNTS=OpenAI,GoogleDeepMind,AnthropicAI,huggingface,svpino,DrJimFan

# ---- Telegram (aprobación humana, gratis) ----
# Bot con @BotFather + tu chat_id con @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Imágenes (nano banana, cuota gratis AI Studio) ----
# Si la cuota diaria se agota, el post sale sin imagen (sin error).
ENABLE_IMAGES=true
IMAGE_MODEL=gemini-2.5-flash-image

# ---- Agente ----
POSTS_PER_DAY=3            # por ciclo; 2 ciclos/día = 6 posts/día (capa Free: máx 17/día)
IMAGE_RATIO=0.5            # fracción de posts con imagen
POST_HOURS=9,18            # horas fijas de publicación (FREE_MODE)
TIMEZONE=America/Santiago
DRY_RUN=true   # true = no publica, solo envía borradores a Telegram
DATA_DIR=./data            # memoria, historial y horarios (ruta local = Termux OK)

# ---- Inteligencia 2026 ----
MEMORY_ENABLED=true        # memoria de contenido (anti-repetición + learnings)
CRITIC_THRESHOLD=0.8       # nota mínima del crítico para enviar a Telegram
CRITIC_MAX_RETRIES=2       # reescrituras máx. por borrador
MCP_SERVERS=[]             # fuentes MCP extra (JSON); vacío = desactivado

# ---- Crecimiento ----
# Follow/unfollow: a mano desde la app de X (gratis, sin riesgo anti-spam).
# Respuestas propuestas: desactivadas en FREE_MODE (requieren leer X).
